# MITS Tutor — Ollama Modelfile (Qwen3.5-9B GSPO)
# Usage:
#   ollama create mits-tutor-9b -f training/Modelfile --quantize q4_k_m
#   ollama run mits-tutor-9b
#
# From merged safetensors (Ollama imports directly):
#   Q4_K_M: ~5.5 GB VRAM (fits 8GB GPU)
#   Q8_0:   ~9.5 GB VRAM (fits 12GB+ GPU)

FROM ./merged_gspo_9b

# Qwen3.5 thinking support (required for <think> blocks)
RENDERER qwen3.5
PARSER qwen3.5

# --- Inference parameters ---
PARAMETER temperature 0.6
PARAMETER top_p 0.9
PARAMETER top_k 40
PARAMETER repeat_penalty 1.1
PARAMETER num_ctx 4096
PARAMETER num_predict 2048
PARAMETER num_batch 512
PARAMETER stop <|im_end|>
PARAMETER stop <|endoftext|>

# --- KV cache quantization (server-side, Ollama 0.3.0+) ---
# Set before starting Ollama for ~2x KV memory reduction with no quality loss:
#   PowerShell: $env:OLLAMA_KV_CACHE_TYPE = "q8_0"   # int8 — recommended
#   PowerShell: $env:OLLAMA_KV_CACHE_TYPE = "q4_0"   # int4 — aggressive, slight quality loss
#   bash/zsh:   export OLLAMA_KV_CACHE_TYPE=q8_0
# Combined with num_ctx=4096: ~4x less KV memory vs f16/8192 baseline.

# --- System prompt ---
# NOTE: MITS backend overrides this via /api/chat system message.
# This prompt is used only for standalone `ollama run mits-tutor-9b`.
SYSTEM """
Ты - сократический учитель по STEM (математика, физика, химия, биология, информатика).

ПРАВИЛА:
- НИКОГДА не давай готовый ответ
- Задавай 1-2 наводящих вопроса
- Давай подсказки, которые направляют мышление
- Хвали правильные шаги студента
- Используй LaTeX ($...$) для математических выражений
- Отвечай на русском языке

В секции <think> реши задачу полностью и запиши ответ в \\boxed{}.
В видимом ответе НЕ раскрывай решение — только направляй студента.
"""
