# =============================================================================
# MITS — пример конфигурации (.env.example)
# Скопируйте в .env и заполните значения перед запуском.
# =============================================================================

# =============================================================================
# Режим запуска
# =============================================================================
# В проде ОБЯЗАТЕЛЬНО установить DEBUG=false + задать JWT_SECRET_KEY
DEBUG=true

# =============================================================================
# JWT
# =============================================================================
# В проде обязателен при DEBUG=false — иначе бэкенд упадёт при старте.
# Генерация: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# LLM backend
# =============================================================================
# Продовый стек: llama-server / llama-swap на порту 8090 (GGUF Q4_K_M).
# Ollama — legacy-альтернатива (раскомментировать LLM_BACKEND=ollama ниже).
LLM_BACKEND=llamacpp
LLM_BASE_URL=http://127.0.0.1:8090/v1
LLM_MODEL=mits-tutor

# Legacy Ollama (раскомментировать при необходимости):
# LLM_BACKEND=ollama
# OLLAMA_HOST=http://localhost:11434

# =============================================================================
# Модели
# =============================================================================
MODEL_NAME=mits-tutor-9b-think
MODEL_PRIMARY=mits-tutor-9b-think
MODEL_FINETUNED=mits-tutor-9b-fast
MODEL_FALLBACK=mits-tutor-9b-think
USE_FINETUNED=true
AUTO_SELECT_MODEL=true

# =============================================================================
# База данных
# =============================================================================
DATABASE_URL=sqlite+aiosqlite:///./backend/data/mits.db

# =============================================================================
# CORS
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# Frontend (Next.js)
# Эти переменные — для frontend/.env.local, не для .env бэкенда.
# Значения — BASE URL; пути /api/v1/... дописываются кодом автоматически.
# =============================================================================
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_WS_URL=ws://localhost:8000

# =============================================================================
# Аффективный детектор
# =============================================================================
# rules = rule-based (быстро, без GPU)
# ml    = RuBERT-модель (data/models/rubert_affect, нужна отдельная загрузка)
AFFECT_DETECTOR_TYPE=rules

# =============================================================================
# Параметры инференса
# =============================================================================
TEMPERATURE=0.7
TOP_P=0.95
TOP_K=0
MIN_P=0.01
MAX_TOKENS=2048
CONTEXT_LENGTH=8192
THINKING_MODE=true
SHOW_THINKING=false

# =============================================================================
# Cerebras API (для генерации обучающих данных — опционально)
# =============================================================================
# CEREBRAS_API_KEY_1=csk-your-key-here
