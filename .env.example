# ======================
# Ollama Settings (для inference)
# ======================
OLLAMA_HOST=http://localhost:11434

# Model Selection
# ─────────────────────────────────────────────────────────────
# Primary: glm-reap-23b (Cerebras REAP-pruned GLM, 48 experts, ~14GB Q4_K_M)
#   - 25% меньше параметров (23B vs 30B), сохраняет качество
#   - MoE: 3B активных параметров на токен (как и оригинал)
#   - Быстрее загружается, меньше RAM
#
# Fallback: glm-4.7-flash (original 64 experts, 30B)
# ─────────────────────────────────────────────────────────────
#
# УСТАНОВКА REAP МОДЕЛИ:
#
# 1. Скачать GGUF (Q4_K_M, 14.1GB):
#    huggingface-cli download unsloth/GLM-4.7-Flash-REAP-23B-A3B-GGUF \
#      GLM-4.7-Flash-REAP-23B-A3B-Q4_K_M.gguf --local-dir ./models
#
# 2. Создать Modelfile:
#    cat > Modelfile << 'EOF'
#    FROM ./models/GLM-4.7-Flash-REAP-23B-A3B-Q4_K_M.gguf
#    PARAMETER temperature 0.7
#    PARAMETER top_p 0.95
#    PARAMETER min_p 0.01
#    PARAMETER repeat_penalty 1.0
#    PARAMETER num_ctx 8192
#    EOF
#
# 3. Создать модель в Ollama:
#    ollama create glm-reap-23b -f Modelfile
#
# 4. ВАЖНО: Исправить metadata (без этого модель работает некорректно!)
#    См. docs/setup_reap_model.md для подробной инструкции
#
# 5. Проверить:
#    ollama run glm-reap-23b "Реши: 2x + 5 = 13"
# ─────────────────────────────────────────────────────────────
MODEL_NAME=glm-reap-23b
MODEL_PRIMARY=glm-reap-23b
MODEL_FALLBACK=glm-4.7-flash

# Hardware Optimization
# ─────────────────────────────────────────────────────────────
# GPU_LAYERS: количество слоёв модели на GPU (остальные на CPU/RAM)
#
# Рекомендации по GPU_LAYERS для GLM-4.7-Flash (32 слоя):
#   GTX 1650/1660 (4GB):  GPU_LAYERS=10-15  (~3GB VRAM)
#   RTX 2060/3060 (6GB):  GPU_LAYERS=18-22  (~5GB VRAM)
#   RTX 2070/2080 (8GB):  GPU_LAYERS=25-28  (~6GB VRAM)
#   RTX 3080/4070 (12GB): GPU_LAYERS=32     (полностью на GPU)
#   RTX 3090/4080 (16GB+): GPU_LAYERS=999   (всё на GPU + большой контекст)
#
# Для CPU-only: GPU_LAYERS=0
# ─────────────────────────────────────────────────────────────
GPU_LAYERS=25
CONTEXT_LENGTH=4096

# Sampling Parameters (optimized for REAP model)
# WARNING: temp < 0.5 causes repetition loops with REAP!
TEMPERATURE=0.7
TOP_P=0.95
TOP_K=0
MIN_P=0.01
REPETITION_PENALTY=1.0

# KV Cache Quantization
KV_CACHE_K_TYPE=q8_0
KV_CACHE_V_TYPE=q4_0

# ─────────────────────────────────────────────────────────────
# Backend Selection
# ─────────────────────────────────────────────────────────────
# Options: ollama, exllamav2, llama.cpp
#
# ollama     - Easy setup, good for most cases
# exllamav2  - Best for MoE models (expert-level offloading)
# llama.cpp  - Advanced control, requires separate server
# ─────────────────────────────────────────────────────────────
MODEL_BACKEND=ollama

# ─────────────────────────────────────────────────────────────
# ExLlamaV2 Settings (for MoE optimization)
# ─────────────────────────────────────────────────────────────
# Install: pip install exllamav2
#
# EXLLAMA_MODEL_PATH - Path to model with safetensors/GGUF
# EXLLAMA_GPU_SPLIT  - VRAM per GPU in GB (e.g., "8.0" or "8.0,8.0")
# EXLLAMA_EXPERT_CACHE - Number of MoE experts to keep on GPU (8-16 recommended)
#
# Advantages for MoE models:
# - Expert-level offloading (not just layer-level)
# - Dynamic expert caching (hot experts stay on GPU)
# - 20-30% less VRAM usage with same performance
# ─────────────────────────────────────────────────────────────
# EXLLAMA_MODEL_PATH=/path/to/glm-4-model
# EXLLAMA_GPU_SPLIT=8.0
# EXLLAMA_EXPERT_CACHE=8
# EXLLAMA_FLASH_ATTENTION=true

# Performance Logging
LOG_INFERENCE_METRICS=true
METRICS_DB_PATH=./data/metrics.db

# Tutoring Settings
MAX_HINTS=3
MAX_ATTEMPTS_BEFORE_TELLING=5
THINKING_MODE=true

# Knowledge Tracing
INITIAL_MASTERY=0.3
LEARN_RATE=0.1
FORGET_RATE=0.05

# Database
DB_PATH=./data/mits.db
VECTOR_DB_PATH=./data/chromadb

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Development
DEBUG=false

# ======================
# Extended Features
# ======================

# REST API Settings
# ─────────────────────────────────────────────────────────────
API_SECRET_KEY=your-secret-key-min-32-characters-long
API_RATE_LIMIT=60
API_TOKEN_EXPIRE_HOURS=24

# Gamification
# ─────────────────────────────────────────────────────────────
GAMIFICATION_ENABLED=true
XP_MULTIPLIER=1.0
STREAK_FREEZE_COUNT=3

# Spaced Repetition
# ─────────────────────────────────────────────────────────────
SPACED_REPETITION_ENABLED=true
SM2_INITIAL_EASINESS=2.5
SM2_MIN_EASINESS=1.3

# Caching
# ─────────────────────────────────────────────────────────────
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_MAX_SIZE=100000
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL_SECONDS=3600

# Streaming
# ─────────────────────────────────────────────────────────────
STREAMING_ENABLED=true

# ─────────────────────────────────────────────────────────
# Docker-specific overrides (consolidated from .env.docker)
# Uncomment when running via docker-compose
# ─────────────────────────────────────────────────────────
# DATABASE_URL=sqlite+aiosqlite:///data/mits.db
# MODEL_FINETUNED=mits-tutor-ft
# NEXT_PUBLIC_API_URL=http://localhost:8000
# OLLAMA_MODEL=glm-4.7-flash
# SECRET_KEY=change-me-in-production-use-random-string
# USE_FINETUNED=false

# ─────────────────────────────────────────────────────────
# TurboQuant / Ollama optimized overrides (consolidated from .env.optimized)
# Uncomment to enable KV cache compression + speculative decoding
# ─────────────────────────────────────────────────────────
# MAX_TOKENS=4096
