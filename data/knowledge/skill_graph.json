      "description": "Точки, прямые, углы, базовые фигуры",
      "topics": ["points_lines", "angles", "basic_shapes"],
      "mastery_threshold": 0.8
    },
    "geometry_triangles": {
      "name": "Треугольники",
      "prerequisites": ["geometry_basics", "arithmetic"],
      "difficulty": 0.35,
