      "mastery_threshold": 0.7
    },
    "derivative_applications": {
      "name": "Применение производных",
      "prerequisites": ["derivatives", "functions"],
      "difficulty": 0.7,
      "description": "Исследование функций, экстремумы, касательные",
      "topics": ["extrema", "monotonicity", "tangent_line"],
      "mastery_threshold": 0.65
    },
    "integrals": {
      "name": "Интегралы",
      "prerequisites": ["derivatives"],
      "difficulty": 0.7,
      "description": "Неопределённый и определённый интеграл",
      "topics": ["indefinite_integral", "definite_integral", "integration_methods"],
      "mastery_threshold": 0.65
    },
    "integral_applications": {
      "name": "Применение интегралов",
      "prerequisites": ["integrals", "geometry_basics"],
      "difficulty": 0.75,
      "description": "Площадь, объём, длина дуги через интегралы",
      "topics": ["area_under_curve", "volume_of_revolution", "arc_length"],
      "mastery_threshold": 0.6
    }
