      "topics": ["prism", "pyramid", "cylinder", "cone", "sphere"],
      "mastery_threshold": 0.7
    },
    "limits": {
      "name": "Пределы",
      "prerequisites": ["functions", "fractions"],
      "difficulty": 0.6,
      "description": "Понятие предела, вычисление пределов",
      "topics": ["limit_concept", "limit_calculation", "indeterminate_forms"],
      "mastery_threshold": 0.7
    },
    "derivatives": {
      "name": "Производные",
      "prerequisites": ["limits", "powers", "trigonometry_basics"],
      "difficulty": 0.65,
      "description": "Понятие производной, правила дифференцирования",
