{
  "version": "1.0",
  "description": "Граф навыков для математики MITS",
  "skills": {
    "arithmetic": {
      "name": "Арифметика",
      "prerequisites": [],
      "difficulty": 0.1,
      "description": "Базовые операции: сложение, вычитание, умножение, деление",
      "topics": ["addition", "subtraction", "multiplication", "division"],
      "mastery_threshold": 0.8
    },
    "fractions": {
      "name": "Дроби",
      "prerequisites": ["arithmetic"],
      "difficulty": 0.2,
      "description": "Операции с обыкновенными и десятичными дробями",
      "topics": ["common_fractions", "decimal_fractions", "fraction_operations"],
      "mastery_threshold": 0.75
    },
    "variables": {
      "name": "Переменные",
      "prerequisites": ["arithmetic"],
      "difficulty": 0.2,
      "description": "Понимание переменных и простых алгебраических выражений",
      "topics": ["variable_concept", "algebraic_expressions"],
      "mastery_threshold": 0.75
    },
    "powers": {
      "name": "Степени",
      "prerequisites": ["arithmetic"],
      "difficulty": 0.25,
      "description": "Свойства степеней, возведение в степень",
      "topics": ["power_rules", "exponents"],
      "mastery_threshold": 0.75
    },
    "linear_equations": {
      "name": "Линейные уравнения",
      "prerequisites": ["arithmetic", "variables"],
      "difficulty": 0.35,
      "description": "Решение линейных уравнений с одной переменной",
      "topics": ["solving_linear", "equation_balance"],
      "mastery_threshold": 0.8
    },
    "inequalities": {
      "name": "Неравенства",
      "prerequisites": ["linear_equations"],
