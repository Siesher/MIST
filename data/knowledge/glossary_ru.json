    "properties": {
      "product": {
        "ru": "логарифм произведения",
        "formula": "$\\log(ab) = \\log a + \\log b$"
      },
      "quotient": {
        "ru": "логарифм частного",
        "formula": "$\\log\\frac{a}{b} = \\log a - \\log b$"
      },
      "power": {
        "ru": "логарифм степени",
        "formula": "$\\log a^n = n \\log a$"
      },
      "change_of_base": {
        "ru": "переход к другому основанию",
        "formula": "$\\log_a b = \\frac{\\log_c b}{\\log_c a}$"
      }
    }
