  "algebra": {
    "terms": {
      "equation": {
        "ru": "уравнение",
        "definition": "Математическое равенство, содержащее неизвестные величины",
        "examples": ["$x^2 + 5x + 6 = 0$", "$2x - 3 = 7$"]
      },
      "inequality": {
        "ru": "неравенство",
        "definition": "Соотношение, указывающее, что одно выражение больше или меньше другого",
        "examples": ["$x > 5$", "$2x + 1 \\leq 10$"]
      },
      "polynomial": {
        "ru": "многочлен",
        "definition": "Сумма одночленов",
        "examples": ["$x^3 - 2x^2 + x - 5$"]
      },
      "coefficient": {
        "ru": "коэффициент",
        "definition": "Числовой множитель при переменной"
      },
      "variable": {
        "ru": "переменная",
        "definition": "Символ, обозначающий неизвестную или изменяющуюся величину"
      },
      "constant": {
        "ru": "константа",
        "definition": "Величина, не изменяющая своего значения"
      },
      "root": {
        "ru": "корень",
        "plural": "корни",
        "definition": "Значение переменной, обращающее уравнение в верное равенство"
      },
      "solution": {
        "ru": "решение",
        "definition": "Значение или множество значений, удовлетворяющих условию"
      },
      "discriminant": {
        "ru": "дискриминант",
        "definition": "Выражение $D = b^2 - 4ac$ для квадратного уравнения",
        "formula": "$D = b^2 - 4ac$"
      },
      "factorization": {
        "ru": "разложение на множители",
        "definition": "Представление выражения в виде произведения более простых выражений"
      }
    }
  },
  "calculus": {
    "terms": {
      "derivative": {
        "ru": "производная",
        "definition": "Предел отношения приращения функции к приращению аргумента",
        "notation": "$f'(x)$ или $\\frac{df}{dx}$"
      },
      "integral": {
        "ru": "интеграл",
        "definition": "Операция, обратная дифференцированию",
        "notation": "$\\int f(x)\\,dx$"
      },
      "definite_integral": {
        "ru": "определённый интеграл",
        "notation": "$\\int_a^b f(x)\\,dx$"
      },
      "indefinite_integral": {
        "ru": "неопределённый интеграл",
        "notation": "$\\int f(x)\\,dx + C$"
      },
      "limit": {
        "ru": "предел",
        "definition": "Значение, к которому стремится функция",
        "notation": "$\\lim_{x \\to a} f(x)$"
      },
      "continuity": {
        "ru": "непрерывность",
        "definition": "Свойство функции не иметь разрывов"
      },
      "differentiability": {
        "ru": "дифференцируемость",
        "definition": "Свойство функции иметь производную в данной точке"
      },
      "antiderivative": {
        "ru": "первообразная",
        "definition": "Функция, производная которой равна данной функции"
      },
      "extremum": {
        "ru": "экстремум",
        "plural": "экстремумы",
        "definition": "Максимум или минимум функции"
      },
      "inflection_point": {
        "ru": "точка перегиба",
        "definition": "Точка, в которой функция меняет направление выпуклости"
      }
    },
    "rules": {
      "chain_rule": {
        "ru": "цепное правило",
        "alt": "правило дифференцирования сложной функции",
        "formula": "$(f(g(x)))' = f'(g(x)) \\cdot g'(x)$"
      },
      "product_rule": {
        "ru": "правило произведения",
        "formula": "$(uv)' = u'v + uv'$"
      },
      "quotient_rule": {
        "ru": "правило частного",
        "formula": "$\\left(\\frac{u}{v}\\right)' = \\frac{u'v - uv'}{v^2}$"
      },
      "integration_by_parts": {
        "ru": "интегрирование по частям",
        "formula": "$\\int u\\,dv = uv - \\int v\\,du$"
      },
      "substitution": {
        "ru": "замена переменной",
        "alt": "метод подстановки"
      }
    }
  },
